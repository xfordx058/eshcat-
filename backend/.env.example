# --- eSHCAT environment configuration (copy to .env) ---
# Flask
FLASK_ENV=development
SECRET_KEY=change-this-secret-key-in-production
DEBUG=True

# Database
# Set DB_DRIVER=mysql to use the existing MySQL database. Keep sqlite for local demo mode.
DB_DRIVER=sqlite
DATABASE_PATH=eshcat.sqlite
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=eshcat
MYSQL_USER=root
MYSQL_PASSWORD=

# Gmail SMTP (use a dedicated account + Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=SSL
SMTP_USERNAME=ehscathackathon@gmail.com
SMTP_PASSWORD=uffu kxld zjjy hkjb

# Email sender shown to recipients
MAIL_FROM=eSHCAT <no-reply@eshcat.local>

# Seed default password for demo staff accounts
STAFF_SEED_PASSWORD=change_me_123
