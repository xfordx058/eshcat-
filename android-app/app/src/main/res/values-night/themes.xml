<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Night variant of the base application theme. eSHCAT is Compose-only;
         the Android XML context only needs a minimal theme without an action bar. -->
    <style name="Base.Theme.ESHCAT" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>